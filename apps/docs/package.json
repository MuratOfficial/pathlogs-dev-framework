{
  "name": "@toimetdev/pathlogs-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deps": "tsc -b ../../packages/core",
    "pages": "node scripts/gen-pages.mjs",
    "predev": "tsc -b ../../packages/core",
    "dev": "node scripts/gen-pages.mjs && next dev",
    "prebuild": "tsc -b ../../packages/core",
    "build": "node scripts/gen-pages.mjs && next build",
    "start": "next start",
    "pretypecheck": "tsc -b ../../packages/core",
    "typecheck": "node scripts/gen-pages.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@toimetdev/pathlogs-core": "0.1.0",
    "@toimetdev/pathlogs-hooks": "0.1.0",
    "@toimetdev/pathlogs-tokens": "0.1.0",
    "next": "^15.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.0"
  }
}
