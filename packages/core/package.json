{
  "name": "@toimetdev/pathlogs-core",
  "version": "0.1.0",
  "description": "Headless-friendly React components for the PathLogs UI framework: dialogs, menus, tooltips, command palette, markdown.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "styles"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles/*": "./styles/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "tsc -b ."
  },
  "dependencies": {
    "@toimetdev/pathlogs-hooks": "0.1.0",
    "@toimetdev/pathlogs-tokens": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "dialog",
    "command-palette",
    "markdown"
  ],
  "author": "Murat Toimet <toimetm@gmail.com>",
  "homepage": "https://github.com/MuratOfficial/pathlogs-dev-framework#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuratOfficial/pathlogs-dev-framework.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/MuratOfficial/pathlogs-dev-framework/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
