{
  "name": "pathlogs-ui",
  "version": "0.1.0",
  "description": "CLI that copies PathLogs widgets (kanban, gantt, filter bar) into your project, shadcn-style.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pathlogs-ui": "./dist/index.js"
  },
  "files": ["dist", "registry"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node scripts/bundle-registry.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["cli", "ui", "registry", "kanban", "gantt", "react"]
}
