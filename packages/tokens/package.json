{
  "name": "@toimetdev/pathlogs-tokens",
  "version": "0.1.0",
  "description": "Design tokens, theming and color utilities for the PathLogs UI framework.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "styles"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles/*": "./styles/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "tsc -b ."
  },
  "keywords": [
    "design-tokens",
    "theme",
    "dark-mode",
    "tailwind",
    "css-variables"
  ],
  "author": "Murat Toimet <toimetm@gmail.com>",
  "homepage": "https://github.com/MuratOfficial/pathlogs-dev-framework#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuratOfficial/pathlogs-dev-framework.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/MuratOfficial/pathlogs-dev-framework/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
