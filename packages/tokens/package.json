{
  "name": "@pathlogs/tokens",
  "version": "0.1.0",
  "description": "Design tokens, theming and color utilities for the PathLogs UI framework.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["*.css"],
  "files": ["dist", "styles"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles/*": "./styles/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["design-tokens", "theme", "dark-mode", "tailwind", "css-variables"]
}
