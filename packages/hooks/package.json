{
  "name": "@toimetdev/pathlogs-hooks",
  "version": "0.1.0",
  "description": "Behavioral React hooks for the PathLogs UI framework: drag-scroll, hotkeys, SSE, theming.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "tsc -b ."
  },
  "dependencies": {
    "@toimetdev/pathlogs-tokens": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "keywords": [
    "react",
    "hooks",
    "drag-scroll",
    "hotkeys",
    "sse",
    "theme"
  ],
  "author": "Murat Toimet <toimetm@gmail.com>",
  "homepage": "https://github.com/MuratOfficial/pathlogs-dev-framework#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuratOfficial/pathlogs-dev-framework.git",
    "directory": "packages/hooks"
  },
  "bugs": {
    "url": "https://github.com/MuratOfficial/pathlogs-dev-framework/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
