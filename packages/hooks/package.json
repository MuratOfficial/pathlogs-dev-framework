{
  "name": "@pathlogs/hooks",
  "version": "0.1.0",
  "description": "Behavioral React hooks for the PathLogs UI framework: drag-scroll, hotkeys, SSE, theming.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pathlogs/tokens": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "keywords": ["react", "hooks", "drag-scroll", "hotkeys", "sse", "theme"]
}
