{
  "name": "pathlogs-dev-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for the PathLogs UI framework: npm packages + a shadcn-style widget registry.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/tokens packages/hooks packages/core packages/cli",
    "clean": "tsc -b --clean packages/tokens packages/hooks packages/core packages/cli",
    "typecheck": "npm run build && tsc -p registry/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "node packages/cli/dist/index.js",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}