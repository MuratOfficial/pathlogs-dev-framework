{
  "name": "pathlogs-dev-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for the PathLogs UI framework: npm packages + a shadcn-style widget registry.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b packages/tokens packages/hooks packages/core packages/cli",
    "clean": "tsc -b --clean packages/tokens packages/hooks packages/core packages/cli",
    "typecheck": "npm run build && tsc -p registry/tsconfig.json && npm run typecheck -w @toimetdev/pathlogs-docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "node packages/cli/dist/index.js",
    "check": "node scripts/sync-versions.mjs --check && npm run typecheck && npm run test",
    "release:dry": "node scripts/sync-versions.mjs --check && npm publish --dry-run -w @toimetdev/pathlogs-tokens -w @toimetdev/pathlogs-hooks -w @toimetdev/pathlogs-core -w @toimetdev/pathlogs-ui",
    "release": "npm run check && npm publish -w @toimetdev/pathlogs-tokens -w @toimetdev/pathlogs-hooks -w @toimetdev/pathlogs-core -w @toimetdev/pathlogs-ui",
    "docs": "npm run dev -w @toimetdev/pathlogs-docs",
    "docs:build": "npm run build -w @toimetdev/pathlogs-docs",
    "sync-versions": "node scripts/sync-versions.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Murat Toimet <toimetm@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuratOfficial/pathlogs-dev-framework.git"
  }
}
